# Copy to .env for local development, and set the same variables in Vercel
# (Project Settings > Environment Variables) for production.

# Supabase (Project Settings > API Keys). The VITE_ values are public and safe in
# the browser. The secret key is server-only: never prefix it with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
